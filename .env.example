# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — copy from your Supabase project dashboard
# Settings > API > Project URL and anon/public key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — copy from your Stripe dashboard
# Developers > API keys for secret key and webhook secret
# Products > Pricing for price IDs
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_API_VERSION=2025-11-20.acacia
